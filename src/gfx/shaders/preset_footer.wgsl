
// Unpack the globals into the u* variables. Every entry point does this
// before anything else.
fn loadGlobals() {
  uRes = G.a.xy;
  uTime = G.a.z;
  uDt = G.a.w;
  uBass = G.b.x;
  uMid = G.b.y;
  uTreb = G.b.z;
  uLevel = G.b.w;
  uBeat = G.c.x;
  uPhase = G.c.y;
  uBeats = G.c.z;
  uHistHead = G.c.w;
  FR = G.d.x;
  uCentroid = G.d.y;
  uIdle = G.d.z;
  uEnergy = G.d.w;
  uOnsetLow = G.e.x;
  uOnsetMid = G.e.y;
  uOnsetHigh = G.e.z;
  uHarmony = G.e.w;
  uOnsetLowN = G.f.x;
  uOnsetMidN = G.f.y;
  uOnsetHighN = G.f.z;
  uTonal = G.f.w;
  uBeatAges = G.beat_ages;
  uBeatAge = G.beat_ages.x;
  uOnsetLowAges = G.low_ages;
  uOnsetMidAges = G.mid_ages;
  uOnsetHighAges = G.high_ages;
  uReact = G.g.x;
  uBassLine = G.g.y;
  uTune = G.g.z;
  uPitch = G.g.w;
  uKick = G.e.x;
  uSnare = G.e.y;
  uHat = G.e.z;
  uKickN = G.f.x;
  uSnareN = G.f.y;
  uHatN = G.f.z;
  uKickAges = G.low_ages;
  uSnareAges = G.mid_ages;
  uHatAges = G.high_ages;
  uKickHits = G.kick_hits;
  uSnareHits = G.snare_hits;
  uHatHits = G.hat_hits;
  uNote = G.h.x;
  uNoteN = G.h.y;
  uNoteAges = G.note_ages;
  uNoteHits = G.note_hits;
  uDrive = G.drive;
}
